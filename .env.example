# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# Your GitHub username — used by the GitHub Activity component
VITE_GITHUB_USERNAME=your_github_username_here

# Your LeetCode username — used by the Achievements section to fetch live stats
VITE_LEETCODE_USERNAME=your_leetcode_username_here

# Your Google Cloud Skill Boost profile ID (e.g. from public_profiles/YOUR_ID)
VITE_GCSB_PROFILE_ID=your_gcsb_profile_id_here

# Your Credly username (e.g. from credly.com/users/YOUR_USERNAME)
VITE_CREDLY_USERNAME=your_credly_username_here

# Your HackerRank username
VITE_HACKERRANK_USERNAME=your_hackerrank_username_here

# ─── Backend (Express server) ───────────────────────────────────────────────────
# GitHub Personal Access Token — used by scripts/update-skills.js
# to fetch your repos. Leave blank for unauthenticated (60 req/hr limit).
# Get one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_personal_access_token_here

# ─── Production (optional) ─────────────────────────────────────────────────────
# Port for the Express server (defaults to 3001 if not set)
# PORT=3001

